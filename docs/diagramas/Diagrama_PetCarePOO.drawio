        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml PetCare\nskinparam classAttributeIconSize 0\nskinparam linetype ortho\nskinparam shadowing false\nskinparam packageStyle folder\nskinparam class {\n  BackgroundColor White\n  BorderColor #4A6275\n  ArrowColor #4A6275\n}\n\n&#39; ===================== PAQUETES =====================\n\npackage \&quot;modelo.personas\&quot; #E6ECFA {\n  abstract class Persona {\n    #nombre: String\n    #apellido: String\n    #telefono: String\n    #correo: String\n    --\n    +actualizarContacto(telefono: String, correo: String): void\n    +{abstract} describirRol(): String\n    +getNombre(): String\n    +setNombre(nombre: String): void\n    +getApellido(): String\n    +setApellido(apellido: String): void\n    +getTelefono(): String\n    +setTelefono(telefono: String): void\n    +getCorreo(): String\n    +setCorreo(correo: String): void\n  }\n\n  class Propietario {\n    -direccion: String\n    -mascotas: List&lt;Mascota&gt;\n    --\n    +agregarMascota(mascota: Mascota): void\n    +listarMascotas(): List&lt;Mascota&gt;\n    +describirRol(): String\n    +toString(): String\n  }\n\n  class Veterinario {\n    -cedulaProfesional: String\n    -especialidad: String\n    --\n    +describirRol(): String\n    +toString(): String\n  }\n\n  class Recepcionista {\n    -turno: String\n    --\n    +registrarCita(cita: Cita): void\n    +describirRol(): String\n  }\n}\n\npackage \&quot;modelo.mascotas\&quot; #E6F4E6 {\n  abstract class Mascota {\n    #nombre: String\n    -edad: int\n    -peso: double\n    -propietario: Propietario\n    -historial: HistorialClinico\n    --\n    +{abstract} hacerSonido(): String\n    +toString(): String\n    +getNombre(): String\n    +setNombre(nombre: String): void\n    +getEdad(): int\n    +setEdad(edad: int): void\n    +getPeso(): double\n    +setPeso(peso: double): void\n    +getDueno(): Propietario\n    +setDueno(propietario: Propietario): void\n    +getHistorial(): HistorialClinico\n  }\n\n  class Perro {\n    -raza: String\n    -nivelEnergia: String\n    --\n    +hacerSonido(): String\n    +toString(): String\n  }\n\n  class Gato {\n    -domestico: boolean\n    --\n    +hacerSonido(): String\n    +toString(): String\n  }\n\n  class AveExotica {\n    -longitudAlas: double\n    --\n    +hacerSonido(): String\n    +toString(): String\n  }\n}\n\npackage \&quot;modelo.servicios\&quot; #FFF0DC {\n  abstract class Servicio {\n    #nombre: String\n    --\n    +getNombre(): String\n    +setNombre(nombre: String): void\n  }\n\n  interface Facturable {\n    +calcularCosto(): BigDecimal\n  }\n\n  class ConsultaGeneral {\n    -tarifaBase: BigDecimal\n    --\n    +calcularCosto(): BigDecimal\n    +toString(): String\n  }\n\n  class Vacunacion {\n    -costoVacuna: BigDecimal\n    -tarifaAplicacion: BigDecimal\n    --\n    +calcularCosto(): BigDecimal\n    +toString(): String\n  }\n\n  class Cirugia {\n    -complejidad: String\n    -horasQuirofano: double\n    -tarifaPorHora: BigDecimal\n    --\n    +calcularCosto(): BigDecimal\n    +toString(): String\n  }\n}\n\npackage \&quot;modelo.clinica\&quot; #F1E4F5 {\n  enum EstadoCita {\n    PROGRAMADA\n    ATENDIDA\n    CANCELADA\n  }\n\n  class HistorialClinico {\n    -citas: List&lt;Cita&gt;\n    --\n    +registrarAtencion(cita: Cita): void\n    +listarCitas(): List&lt;Cita&gt;\n  }\n\n  class Cita {\n    -citaId: String\n    -fechaHora: LocalDateTime\n    -estado: EstadoCita {readOnly}\n    -mascota: Mascota\n    -veterinario: Veterinario\n    -consultorio: Consultorio\n    -servicio: Servicio\n    -observaciones: String\n    -comprobante: Comprobante\n    --\n    +asignarConsultorio(consultorio: Consultorio): void\n    +atender(): void\n    +cancelar(): void\n    +registrarObservaciones(observaciones: String): void\n    +generarComprobante(): Comprobante\n  }\n\n  class Consultorio {\n    -numero: int\n    --\n    +getNumero(): int\n    +setNumero(numero: int): void\n  }\n\n  class Clinica {\n    -nombre: String\n    -consultorios: List&lt;Consultorio&gt;\n    -veterinarios: List&lt;Veterinario&gt;\n    -citas: List&lt;Cita&gt;\n    --\n    +crearConsultorio(numero: int): Consultorio\n    +agregarVeterinario(veterinario: Veterinario): void\n    +agendarCita(cita: Cita): void\n    +buscarCita(folio: String): Cita\n    +buscarCita(fecha: LocalDate): List&lt;Cita&gt;\n    +validarDisponibilidad(veterinario: Veterinario, fechaHora: LocalDateTime): boolean\n    +consultarTotalCobradoPorVeterinario(veterinario: Veterinario): BigDecimal\n    +consultarCobrosPorMascota(mascota: Mascota): List&lt;Comprobante&gt;\n  }\n}\n\npackage \&quot;modelo.comprobante\&quot; #FBE4EC {\n  class Comprobante {\n    -folio: String\n    -total: BigDecimal\n    -cita: Cita\n    --\n    +imprimir(): String\n  }\n}\n\n&#39; ===================== HERENCIA =====================\nPersona &lt;|-- Propietario\nPersona &lt;|-- Veterinario\nPersona &lt;|-- Recepcionista\n\nMascota &lt;|-- Perro\nMascota &lt;|-- Gato\nMascota &lt;|-- AveExotica\n\nServicio &lt;|-- ConsultaGeneral\nServicio &lt;|-- Vacunacion\nServicio &lt;|-- Cirugia\n\n&#39; ===================== REALIZACIÓN =====================\nFacturable &lt;|.. ConsultaGeneral\nFacturable &lt;|.. Vacunacion\nFacturable &lt;|.. Cirugia\n\n&#39; ===================== ASOCIACIONES =====================\nPropietario \&quot;1\&quot; -- \&quot;0..*\&quot; Mascota\nMascota \&quot;1\&quot; *-- \&quot;1\&quot; HistorialClinico\nHistorialClinico \&quot;1\&quot; o-- \&quot;0..*\&quot; Cita\nMascota \&quot;1\&quot; -- \&quot;0..*\&quot; Cita\nVeterinario \&quot;1\&quot; -- \&quot;0..*\&quot; Cita\nServicio \&quot;1\&quot; -- \&quot;0..*\&quot; Cita\nConsultorio \&quot;0..1\&quot; -- \&quot;0..*\&quot; Cita\nCita \&quot;0..1\&quot; -- \&quot;1\&quot; Comprobante\n\nCita --&gt; EstadoCita : estado\n\nClinica \&quot;1\&quot; o-- \&quot;0..*\&quot; Veterinario\nClinica \&quot;1\&quot; o-- \&quot;0..*\&quot; Consultorio\nClinica \&quot;1\&quot; o-- \&quot;0..*\&quot; Cita\n\n&#39; ===================== DEPENDENCIA =====================\nRecepcionista ..&gt; Cita : registrarCita\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="H9mA52xfDMJq8-1Pqis9-236">
